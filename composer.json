{
    "name": "tessera/tessera-orders",
    "description": "The Orders module of Tessera: the record of what was sold, voiding and credit sales.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "tessera/tessera-engine": "^4.0",
        "tessera/tessera-tenant": "^4.0",
        "tessera/tessera-catalog": "^4.0",
        "tessera/tessera-customers": "^4.0",
        "tessera/tessera-inventory": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Orders\\": ""
        }
    },
    "extra": {
        "tessera": {
            "modules": [
                "App\\Modules\\Orders\\OrdersServiceProvider"
            ]
